# ============================================================================
# Smart Cane Emergency App - Configuration Environment Variables
# ============================================================================
# INSTRUCTIONS:
# 1. Copier ce fichier en .env
# 2. Remplir les valeurs pour votre environnement
# 3. Ne jamais commiter le fichier .env en production (ajouter à .gitignore)
# ============================================================================

# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================

# Mode de débogage (JAMAIS True en production!)
DEBUG=False

# Clé secrète (Générer une nouvelle clé sécurisée)
# Générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Hôtes autorisés (domaines/IPs autorisés)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ============================================================================
# DATABASE POSTGRESQL
# ============================================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=smart_cane_db
DB_USER=postgres
DB_PASSWORD=your-secure-database-password-change-this
DB_HOST=db              # Pour Docker: 'db', sinon 'localhost'
DB_PORT=5432

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_PASSWORD=redis_password_change_this
CELERY_BROKER_URL=redis://:redis_password_change_this@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password_change_this@redis:6379/0

# ============================================================================
# JWT TOKEN CONFIGURATION
# ============================================================================

# Durée de vie du token d'accès (en heures)
JWT_ACCESS_TOKEN_LIFETIME=1

# Durée de vie du token de rafraîchissement (en jours)
JWT_REFRESH_TOKEN_LIFETIME=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Origines autorisées pour les requêtes CORS
# Ajouter l'URL du frontend Flutter
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://yourdomain.com

# ============================================================================
# GSM/SMS MODULE CONFIGURATION
# ============================================================================

# Port série du module GSM
# Linux: /dev/ttyACM0, /dev/ttyUSB0, etc.
# Windows: COM3, COM4, etc.
# macOS: /dev/tty.usbmodem14631, etc.
GSM_PORT=/dev/ttyACM0

# Vitesse de communication (baud rate)
# Standard: 9600, 19200, 38400, 57600
GSM_BAUD_RATE=9600

# Timeout pour les commandes AT (secondes)
GSM_TIMEOUT=5

# ============================================================================
# EMAIL CONFIGURATION (optionnel)
# ============================================================================

# Backend email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configuration SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password  # Pas le mot de passe Gmail directement!
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ============================================================================
# SECURITY SETTINGS (Production)
# ============================================================================

# HTTPS seulement en production
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logs vers stdout/stderr (utile pour Docker)
LOG_TO_STDOUT=True

# ============================================================================
# APPLICATION SPECIFIC
# ============================================================================

# Fuseau horaire de l'application
TIMEZONE=Africa/Douala

# Langue par défaut
LANGUAGE_CODE=fr-fr

# ============================================================================
# DOCKER SPECIFIC VARIABLES
# ============================================================================

# Compose project name
COMPOSE_PROJECT_NAME=smart_cane

# Image tags
BACKEND_IMAGE_TAG=latest
NGINX_IMAGE_TAG=latest

# ============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# ============================================================================

# Domain for SSL certificate
DOMAIN=yourdomain.com
SUBDOMAIN=www

# Email for Let's Encrypt
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Cloudflare (optionnel, pour DNS)
CLOUDFLARE_API_KEY=your-cloudflare-api-key
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# ============================================================================
# MONITORING & SENTRY (optionnel)
# ============================================================================

# Sentry error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# DataDog API key (optionnel)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ============================================================================
# NOTES IMPORTANTES:
# ============================================================================
# 1. JAMAIS commiter ce fichier modifié en Git!
#    Ajouter à .gitignore: .env, .env.local
#
# 2. En production, utiliser un secrets management:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Kubernetes Secrets
#    - Vault par HashiCorp
#
# 3. Changer TOUS les mots de passe/clés par défaut!
#
# 4. Générer un SECRET_KEY robuste avec:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 5. Pour l'email Gmail:
#    - Activer "Less secure app access" ou utiliser "App Passwords"
#    - Utiliser un app password (16 caractères) plutôt que le mot de passe principal
#
# 6. Permissions sur le fichier .env:
#    chmod 600 .env
