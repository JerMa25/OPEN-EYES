# Environment variables - NEVER commit!
.env
.env.local
.env.*.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.iml
*.code-workspace

# IDE settings (but keep templates)
.vscode/settings.json
.vscode/extensions.json
.vscode/launch.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files
*.sqlite3
*.sqlite
*.db
*.dbf
*.dump

# Media and static files (local development)
media/*
!media/.gitkeep
staticfiles/*
!staticfiles/.gitkeep

# Backups
*.bak
*.backup
backups/
backup_*.sql

# OS specific
.DS_Store
Thumbs.db
.directory
ehthumbs.db

# SSL/TLS certificates (but keep examples)
*.pem
*.key
*.crt
*.cert
!*.example.pem

# Docker
.dockerignore
docker-compose.override.yml

# Redis dumps
dump.rdb

# Node modules (if using Node for frontend build)
node_modules/
npm-debug.log
yarn-lock.json

